/target
/build
# cargo-fuzz build output (the fuzz crate is a separate workspace root). The
# lockfile and the curated seed corpus ARE committed for reproducibility; only
# local fuzzing output/corpora additions are ignored.
/fuzz/target
/fuzz/artifacts
/fuzz/coverage
# Generated libFuzzer corpus entries. The curated seeds under fuzz/corpus/<target>/
# are already tracked, so this ignores only new locally-generated entries.
/fuzz/corpus/*/*
/spike/*.exe
__pycache__/
*.pyc
tests/vectors/local/
*.rs.bk
.idea/
.vscode/
release*/
