/target
/build
# cargo-fuzz build output (the fuzz crate is a separate workspace root). The
# lockfile and the curated seed corpus ARE committed for reproducibility; only
# local fuzzing output/corpora additions are ignored.
/fuzz/target
/fuzz/artifacts
/fuzz/coverage
# Generated libFuzzer corpus entries. The curated seeds under fuzz/corpus/<target>/
# are already tracked, so this ignores only new locally-generated entries.
/fuzz/corpus/*/*
/spike/*.exe
__pycache__/
*.pyc
tests/vectors/local/
*.rs.bk
.idea/
.vscode/
# Local working notes (README-rewrite culled content, future WIKI material)
/.notes/
/release/
# Local Zola binary cache (scripts/get-zola.sh) and the generated site tree.
/.cache/zola/
/web/public/
# Assembled GitHub Pages tree (`.github/scripts/publish-pages.sh`): the Zola
# site copied onto the signed apt repository root (`dists/`, `pool/`, keyring)
# plus the downloaded release .debs. A local publish run must never be
# committed; `web/public` and the Zola cache are ignored where the site
# scaffold defines them.
/site/
