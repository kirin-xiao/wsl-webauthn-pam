// Version resource for WSLWebAuthnBridge.exe.
//
// The Windows WebAuthn prompt's "Requested by <name> (<publisher>)" line is sourced
// from the calling executable's version resource (documented in microsoft/webauthn's
// `webauthn.h`, and relied on by the DEF CON "Passkeys Pwned" analysis). Embedding one
// gives the prompt a human-readable source instead of a bare path.
//
// `__VERSION__` / `__VERSION_COMMAS__` are substituted by build.rs from the crate
// version. This file is LF-only (the repo forbids CR in tracked text files).

1 VERSIONINFO
FILEVERSION __VERSION_COMMAS__
PRODUCTVERSION __VERSION_COMMAS__
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "wsl-webauthn-pam"
            VALUE "FileDescription", "wsl-webauthn-pam Windows Hello bridge"
            VALUE "FileVersion", "__VERSION__"
            VALUE "InternalName", "WSLWebAuthnBridge"
            VALUE "LegalCopyright", "MIT"
            VALUE "OriginalFilename", "WSLWebAuthnBridge.exe"
            VALUE "ProductName", "wsl-webauthn-pam"
            VALUE "ProductVersion", "__VERSION__"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
